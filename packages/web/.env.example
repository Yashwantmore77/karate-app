# Firebase console -> Project settings -> Your apps -> Web app -> Config
# These are public by design. Security lives in firestore.rules.
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FB_PROJECT_ID=your-project
VITE_FB_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FB_SENDER_ID=
VITE_FB_APP_ID=

# Node API base URL. Leave unset to run against the local in-browser mock
# (no backend needed). Set it to point the app at the real @kumite/api server.
VITE_SERVER_URL=http://localhost:4000
