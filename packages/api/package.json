{
  "name": "@kumite/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env index.js",
    "dev": "node --env-file-if-exists=.env --watch index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "seed:sample": "node --env-file-if-exists=.env scripts/seed-sample.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "restore": "node --env-file-if-exists=.env scripts/restore.js"
  },
  "dependencies": {
    "@kumite/shared": "^1.0.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.6.0",
    "nodemailer": "^10.0.15",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3",
    "vitest": "^1.6.1"
  }
}
