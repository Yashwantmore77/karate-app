# Leave unset to use an in-memory user store (fine for local dev/tests).
# Set both to persist users/sessions in MongoDB.
MONGODB_URI=
MONGODB_DB=kumite

# HS256 signing secret for auth tokens. Required in production — without it
# the server signs with a random per-boot secret and logs a warning.
JWT_SECRET=

PORT=4000

# Origin allowed to call this API from a browser (the @kumite/web dev/prod URL).
CORS_ORIGIN=http://localhost:5173
