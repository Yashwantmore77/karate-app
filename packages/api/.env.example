# Leave unset to use an in-memory user store (fine for local dev/tests).
# Set both to persist users/sessions in MongoDB.
MONGODB_URI=
MONGODB_DB=kumite

# "production" on the live server: turns on the checks below.
NODE_ENV=

# HS256 signing secret for auth tokens, 32+ characters. Required in
# production (the server refuses to start without it). Unset in development
# means a random per-boot secret and a warning.
JWT_SECRET=

# The only account the app ever creates by itself: the first Super Admin
# of an empty database (password 8+ characters). Nothing else is seeded — the
# app ships no accounts — so leaving these unset means nothing can sign in.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# "true" shows that address and password on the sign-in screen, with a button
# that fills the form. TESTING ONLY: anyone who can reach the API can read it,
# signed in or not. Leave unset anywhere real.
SHOW_TEST_CREDENTIALS=

# For `npm run demo -- --url <api>`: the administrator it signs in as. Kept
# here rather than on the command line, out of the shell's history.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

# The front end's address, for certificate QR codes and email links.
APP_URL=

# Optional SMS / WhatsApp gateways: the server POSTs { channel, to, text }.
SMS_WEBHOOK_URL=
WHATSAPP_WEBHOOK_URL=

# Requests per minute across the API: per signed-in session, or per address
# for a caller with none.
API_RATE_LIMIT=1200
# Requests per minute per address for reading the public pages and hall
# scoreboards (every screen and phone on the venue Wi-Fi shares one address).
PUBLIC_RATE_LIMIT=6000

PORT=4000

# Origin allowed to call this API from a browser (the @kumite/web dev/prod URL).
CORS_ORIGIN=http://localhost:5173

# --- login audit log --------------------------------------------------------

# Set when a proxy (Vercel, nginx, Cloudflare) sits in front, so the logged
# address is the caller's rather than the proxy's. A hop count, or "loopback"
# / a subnet list. Leave unset when the server is reached directly: the
# X-Forwarded-For header is client-supplied and trusting it without a proxy
# lets callers forge their address and slip the login rate limiter.
TRUST_PROXY=

# Days to keep login records; 0 keeps them forever. Applied as a MongoDB TTL
# index, so changing it later needs the old "at_1" index on loginEvents dropped.
LOGIN_LOG_TTL_DAYS=365

# Optional IP-to-location service, for hosts that supply no geo headers of
# their own (Vercel and Cloudflare already do). {ip} is substituted. Leaving it
# unset means no caller address is ever sent to a third party.
# Example: https://ipapi.co/{ip}/json/
GEOIP_LOOKUP_URL=
